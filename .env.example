# ---------------------------------------------------------------------------
# Gimnasio: variables de entorno.
#
# ESTE ARCHIVO NO TIENE VALORES REALES.
#
# Es una plantilla. Copie a `.env` para desarrollo o a `.env.prod` para
# producción, y complete los valores. El `.env` y el `.env.prod` NO se
# versionan: están en `.gitignore`.
#
# En `.env.example` no hay ninguna clave real: todas las que parecen
# secretos dicen `CAMBIAR`. Un archivo de ejemplo con un secreto de verdad
# termina en un repositorio y ese secreto queda expuesto.
#
# Para generar APP_KEY:
#   docker compose -f deploy/docker-compose.dev.yml run --rm api \
#       php artisan key:generate --show
#
# Para generar los secretos de Authentik:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Aplicación -------------------------------------------------------------

APP_NAME="Gimnasio"
# local, staging o production. En `local`, APP_DEBUG puede ser true.
APP_ENV=local
# En producción tiene que ser "false". Con `true`, un error muestra la
# consulta SQL completa, y eso incluye datos de socios.
APP_DEBUG=true
APP_URL=http://localhost:8080
# Generada con `php artisan key:generate`. Formato: base64:...=
APP_KEY=CAMBIAR-generar-con-artisan-key-generate

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=daily
LOG_DAILY_DAYS=30

# --- Sesión -----------------------------------------------------------------
#
# `lax` (o `strict`) es lo correcto acá: si fuera `none`, el navegador
# bloquea la cookie y nadie puede iniciar sesión.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

# --- Base de datos ----------------------------------------------------------
#
# POSTGRES_INITDB_ARGS con scram-sha-256. Un contenedor nuevo con la
# contraseña por defecto sería una puerta abierta.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gimnasio
DB_USERNAME=gimnasio
DB_PASSWORD=CAMBIAR-en-produccion

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=gimnasio_admin
DB_ADMIN_PASSWORD=

# AVISO IMPORTANTE SOBRE EL ROL DE LA BASE
# ----------------------------------------
# El rol que usa la aplicación NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos cosas, PostgreSQL ignora las políticas de Row
# Level Security por completo y los socios de un gimnasio se verían los del
# otro, sin dar ningún aviso.
#
# `php artisan gimnasio:verificar-aislamiento` comprueba esto y falla si no
# se cumple. Ver docs/03 y docs/08.

# --- Redis ------------------------------------------------------------------
#
# Redis guarda el caché y las colas. No guarda nada que no se pueda volver a
# calcular desde la base: si Redis se borra, el sistema funciona igual.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR-en-produccion
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Authentik (identidad) --------------------------------------------------
#
# No hay contraseñas en este sistema. Authentik demuestra quién es la
# persona; el gimnasio decide con qué papel entra.
#
# La URL del emisor tiene que terminar en barra y coincidir con lo que
# declara el proveedor en Authentik, porque se compara carácter por carácter
# al validar el token.
AUTHENTIK_ISSUER=http://localhost:9000/application/o/gimnasio/
AUTHENTIK_CLIENT_ID=gimnasio
AUTHENTIK_CLIENT_SECRET=CAMBIAR-en-produccion
# RS256 para llaves asimétricas. No cambiar a HS256 sin rehacer la
# configuración de ambos lados.
AUTHENTIK_ALGORITMO=RS256
# Grupo de Authentik que marca al primer administrador del gimnasio.
AUTHENTIK_GRUPO_ADMINISTRADORES=gimnasio-administradores

# --- Dominio (producción) ---------------------------------------------------

APP_DOMAIN=gimnasio.ejemplo.cl
ACME_EMAIL=administracion@ejemplo.cl
LOG_LEVEL_PROD=info

# --- Imágenes (producción) --------------------------------------------------
#
# Producen las imágenes en un registro propio antes de desplegar. Ver
# docs/04, sección "Construcción y despliegue".
API_IMAGE=registro.ejemplo.cl/gimnasio-api:1.0.0
WEB_IMAGE=registro.ejemplo.cl/gimnasio-web:1.0.0

# --- Authentik interno ------------------------------------------------------

AUTHENTIK_SECRET_KEY=CAMBIAR-32-caracteres-hex-generados-con-openssl
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=CAMBIAR-en-produccion
AUTHENTIK_BOOTSTRAP__EMAIL=admin@ejemplo.cl
AUTHENTIK_BOOTSTRAP__PASSWORD=CAMBIAR-en-produccion
AUTHENTIK_BOOTSTRAP__TOKEN=CAMBIAR-en-produccion

# --- Respaldos --------------------------------------------------------------
#
# Ver docs/08. El directorio de respaldos tiene los datos personales de todos
# los socios de todos los gimnasios: es tan sensible como la base.
DIRECTORIO_RESPALDOS=/var/backups/gimnasio
RETENCION_DIAS=30